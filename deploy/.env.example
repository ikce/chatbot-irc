# =====================================================================
# chatbot-irc — bootstrap config
# Ces valeurs alimentent la 1re écriture en DB au premier boot.
# Ensuite, tout se pilote via la WebUI (http://<host>:54878/).
# =====================================================================

# --- App ---
APP_SECRET=change-me-please
LOG_LEVEL=INFO
BOOTSTRAP_FROM_ENV=true

# --- ZNC / IRC (externe) ---
ZNC_HOST=znc.example.tld
ZNC_PORT=6697
ZNC_TLS=true
# Format ZNC classique : "<user>/<network>"
ZNC_USER=eric/libera
ZNC_PASS=change-me
ZNC_NICK=bibi
ZNC_IDENT=bibi
ZNC_REALNAME=Bibi le chatter bot
# Canaux séparés par des virgules
ZNC_CHANNELS=#lab

# --- LLM (via OpenWebUI OpenAI-compat) ---
# URL RACINE d'OpenWebUI (le code append /api/chat/completions)
LLM_URL=https://openwebui.mondomaine.tld
# Bearer OpenWebUI : Settings → Account → API Keys → "Create new secret key"
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=hf.co/cognitivecomputations/dolphin-2.9.3-mistral-nemo-12b-gguf:Q6_K
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=Tu es Bibi, un chatter bot IRC concis et espiègle. Réponds en français, en 1 à 3 phrases maximum.

# --- Web search (via OpenWebUI, même endpoint, feature toggle par requête) ---
WEB_SEARCH_ENABLED=false

# --- Throttle ---
# Cooldown minimum entre 2 réponses du bot (secondes)
THROTTLE_GLOBAL_SEC=3
# Cooldown par nick individuel
THROTTLE_PER_NICK_SEC=10
